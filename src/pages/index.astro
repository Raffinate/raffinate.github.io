---
import { type CollectionEntry, getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import PostPreview from "@/components/blog/PostPreview.astro";
import Note from "@/components/note/Note.astro";
import SocialList from "@/components/SocialList.astro";
import { getAllPosts } from "@/data/post";
import { projects } from "@/data/projects";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import { withBase } from "@/utils/url";

// Posts and notes sections only render once there is content in content/posts or content/notes.
const MAX_POSTS = 10;
const latestPosts = ((await getAllPosts()).sort(collectionDateSort) as CollectionEntry<"post">[]).slice(
	0,
	MAX_POSTS,
);

const MAX_NOTES = 5;
const latestNotes = (await getCollection("note"))
	.sort(collectionDateSort)
	.slice(0, MAX_NOTES) as CollectionEntry<"note">[];
---

<PageLayout meta={{ title: "Home" }}>
	<section>
		<h1 class="title mb-6">Hi!</h1>
		<p class="mb-4">Small things I build in my spare time.</p>
	</section>

	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl">Things</h2>
		<ul class="grid gap-4 sm:grid-cols-2" role="list">
			{
				projects.map((p) => (
					<li class="bg-global-text/5 hover:bg-global-text/10 relative flex flex-col rounded-md px-4 py-3 transition-colors">
						<h3 class="font-semibold">
							<a
								class="cactus-link after:absolute after:inset-0"
								data-ph-capture-attribute-project={p.title}
								data-ph-capture-attribute-link="app"
								href={p.url}
							>
								{p.title}
							</a>
						</h3>
						<p class="text-muted mt-1 mb-3 text-sm">{p.description}</p>
						<a
							class="hover:text-link text-muted relative z-10 mt-auto inline-flex items-center gap-x-1 self-start text-xs"
							data-ph-capture-attribute-project={p.title}
							data-ph-capture-attribute-link="source"
							href={p.repo}
							rel="noreferrer"
							target="_blank"
						>
							<Icon aria-hidden="true" class="h-4 w-4" focusable="false" name="mdi:github" />
							Source
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="mt-16">
		<SocialList />
	</section>

	{
		latestPosts.length > 0 && (
			<section class="mt-16">
				<h2 class="title text-accent mb-6 text-xl">
					<a href={withBase("/posts/")}>Posts</a>
				</h2>
				<ul class="space-y-4" role="list">
					{latestPosts.map((p) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview post={p} />
						</li>
					))}
				</ul>
			</section>
		)
	}
	{
		latestNotes.length > 0 && (
			<section class="mt-16">
				<h2 class="title text-accent mb-6 text-xl">
					<a href={withBase("/notes/")}>Notes</a>
				</h2>
				<ul class="space-y-6" role="list">
					{latestNotes.map((note) => (
						<li>
							<Note note={note} as="h3" isPreview />
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>
